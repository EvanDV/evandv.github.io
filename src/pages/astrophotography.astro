---
// Side B track: photos come from src/data/astrophotos.ts (newest first);
// the title and summary come from src/content/projects/astrophotography.md.
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { PHOTOS } from '../data/astrophotos';

const project = (await getEntry('projects', 'astrophotography'))!;
const d = project.data;
---

<Base title={`${d.title} · Evan Davies-Velie`} description="Astrophotography by Evan Davies-Velie." sky="light">
  <div class="wrap">
    <TopBar back />

    <main class="container">
      <div class="top">
        <PageHeader label={`Side ${d.side} · Track ${d.track}`} title={d.title} accent={d.titleAccent} summary={d.summary} />
      </div>

      <ul class="gallery">
        {
          PHOTOS.map((p) => (
            <li>
              <figure>
                <a class="frame" href={p.image.src} aria-label={`${p.catalog}, ${p.name}: full-size image`}>
                  <Image src={p.image} alt={p.alt} widths={[p.image.width]} sizes={`${p.image.width}px`} />
                </a>
                <figcaption>
                  <span class="catalog mono">{p.catalog}</span>
                  <span class="name">{p.name}</span>
                  <span class="type mono">{p.type}</span>
                  {p.note && <span class="note">{p.note}</span>}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </main>
  </div>
  <Footer bordered />
</Base>

<style>
  .wrap { padding: 24px 24px 0; }
  .top { padding: 72px 0 56px; }
  main { padding-bottom: 112px; }

  .gallery {
    list-style: none;
    margin: 0;
    padding: 40px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr));
    gap: 56px 32px;
    align-items: start;
  }
  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .frame {
    display: block;
    border: 1px solid var(--line);
    background: #000;
    transition: border-color 0.2s;
  }
  .frame:hover { border-color: var(--amber); }
  .frame :global(img) {
    width: 100%;
    height: auto;
  }
  figcaption {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 4px 14px;
  }
  .catalog {
    font-size: 15px;
    color: var(--amber);
  }
  .name {
    font-family: var(--serif);
    font-size: 30px;
    line-height: 1.15;
  }
  .type,
  .note {
    grid-column: 2;
  }
  .type {
    font-size: 12px;
    color: var(--faint);
  }
  .note {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .top { padding: 48px 0 40px; }
  }
</style>
