---
import { NAV, SITE, ZENITH } from '../config';
import { zenithLabel } from '../lib/zenith';

interface Props {
  /** Show a back link instead of the sky coordinates (project pages). */
  back?: boolean;
}

const { back = false } = Astro.props;
---

<header class="topbar container mono">
  {
    back ? (
      <a class="left" href="/">← {SITE.name}</a>
    ) : (
      <span class="left" data-zenith title={`Directly overhead ${ZENITH.place}, right now`}>
        {zenithLabel(ZENITH.lat, ZENITH.lon)}
      </span>
    )
  }
  <nav aria-label="Main">
    {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>

<script>
  import { ZENITH } from '../config';
  import { zenithLabel } from '../lib/zenith';

  // Build-time value is stale by the time anyone reads it; keep it current.
  const el = document.querySelector<HTMLElement>('[data-zenith]');
  if (el) {
    const tick = () => (el.textContent = zenithLabel(ZENITH.lat, ZENITH.lon));
    tick();
    setInterval(tick, 10_000);
  }
</script>

<style>
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding: 8px 0;
  }
  .left {
    color: var(--dim);
    text-decoration: none;
  }
  a.left:hover { color: var(--amber); }
  nav {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--text);
    text-decoration: none;
  }
  nav a:hover { color: var(--amber); }

  @media (max-width: 480px) {
    nav { gap: 20px; }
  }
</style>
