---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  photo?: ImageMetadata;
}

const { photo } = Astro.props;
---

<section class="hero container" aria-labelledby="hero-name">
  <div class="intro">
    <span class="label mono">Vol. 1 — Liner notes</span>
    <h1 id="hero-name">Evan<br /><span class="accent">Davies-Velie</span></h1>
    <p>
      PhD student in the{' '}
      <a href="https://sites.google.com/a/mcgillcosmology.ca/mcgillcosmology/">McGill Cosmology Instrumentation Laboratory</a>,
      building instruments for 21&nbsp;cm cosmology and fast radio bursts. Off the clock: radio host
      on CKUT, random electronics projects, and a growing stack of records.
    </p>
  </div>

  <div class="art">
    <!-- Geometry is in % of the square box so it scales down on phones.
         Matches the mockup's 340px box: record at (40,0), photo at (0,40), both 300px. -->
    <div class="record-box">
      <div class="ring" aria-hidden="true"></div>
      <div class="ring ring-2" aria-hidden="true"></div>
      <div class="ring ring-3" aria-hidden="true"></div>
      <div class="record spin" aria-hidden="true"><div class="hole"></div></div>
      <div class="photo">
        {
          photo ? (
            <Image
              src={photo}
              alt="Evan Davies-Velie working on the feed of a white radio dish"
              width={300}
              height={300}
              densities={[1, 2]}
              quality={85}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <span class="mono">[PLACEHOLDER: PHOTO]</span>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
    padding: 96px 0 120px;
  }
  .intro {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .label {
    letter-spacing: 0.14em;
    color: var(--amber);
  }
  h1 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(48px, 13vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .accent {
    font-style: italic;
    color: var(--amber);
  }
  p {
    margin: 0;
    max-width: 520px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
  }

  p a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--amber);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  p a:hover { color: var(--amber); }

  .art {
    flex: 0 1 380px;
    display: flex;
    justify-content: center;
  }
  .record-box {
    position: relative;
    width: min(340px, 80vw);
    aspect-ratio: 1;
  }
  /* 300/340 = 88.24%, 40/340 = 11.76% */
  .record,
  .photo {
    position: absolute;
    width: 88.24%;
    height: 88.24%;
  }
  .record {
    left: 11.76%;
    top: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #e8b86b 0 14%,
      #0c0f1d 15% 17%,
      #1a1d2e 18% 30%,
      #23263a 31% 32%,
      #1a1d2e 33% 50%,
      #23263a 51% 52%,
      #1a1d2e 53% 100%
    );
  }
  .hole {
    position: absolute;
    left: 50%;
    top: 22%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--bg);
  }
  .photo {
    left: 0;
    top: 11.76%;
    background: #1e2340;
    border: 1px solid #343a63;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--dim);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Rings pulse out from the record's centre: (190,150) in the 340 box.
     Percentage margins resolve against width, which is fine in a square. */
  .ring {
    left: 55.88%;
    top: 44.12%;
    width: 88.24%;
    height: 88.24%;
    margin: -44.12% 0 0 -44.12%;
  }

  @media (max-width: 640px) {
    .hero {
      gap: 48px;
      padding: 64px 0 88px;
    }
    p { font-size: 17px; }
  }
</style>
