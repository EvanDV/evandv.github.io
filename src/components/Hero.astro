---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  photo?: ImageMetadata;
}

const { photo } = Astro.props;
---

<section class="hero container" aria-labelledby="hero-name">
  <div class="intro">
    <span class="label mono">Vol. 1 — Liner notes</span>
    <h1 id="hero-name">Evan<br /><span class="accent">Davies-Velie</span></h1>
    <p>
      PhD student in the{' '}
      <a href="https://sites.google.com/a/mcgillcosmology.ca/mcgillcosmology/">McGill Cosmology Instrumentation Laboratory</a>,
      building instruments for 21&nbsp;cm cosmology and fast radio bursts. Off the clock: radio host
      on CKUT, random electronics projects, and a growing stack of records.
    </p>
  </div>

  <div class="art">
    <!-- A picture disc: grooves around a circular photo label, with rings
         pulsing out from the same centre. Sizes are % of the box so it
         scales down on phones. -->
    <div class="record-box">
      <div class="ring" aria-hidden="true"></div>
      <div class="ring ring-2" aria-hidden="true"></div>
      <div class="ring ring-3" aria-hidden="true"></div>
      <div class="record" aria-hidden="true"><div class="sheen spin"></div></div>
      <div class="disc-label">
        {
          photo ? (
            <Image
              src={photo}
              alt="Evan Davies-Velie working on the feed of a white radio dish"
              width={480}
              height={480}
              densities={[1, 2]}
              quality={85}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <span class="mono">[PLACEHOLDER: PHOTO]</span>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
    padding: 96px 0 120px;
  }
  .intro {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .label {
    letter-spacing: 0.14em;
    color: var(--amber);
  }
  h1 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(48px, 13vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .accent {
    font-style: italic;
    color: var(--amber);
  }
  p {
    margin: 0;
    max-width: 520px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
  }

  p a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--amber);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  p a:hover { color: var(--amber); }

  .art {
    flex: 0 1 460px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .record-box {
    position: relative;
    width: min(460px, 86vw);
    aspect-ratio: 1;
  }
  /* Everything is centred on the box. */
  .record,
  .disc-label,
  .ring {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .record {
    width: 100%;
    height: 100%;
    background:
      repeating-radial-gradient(circle, transparent 0 3px, rgba(255, 255, 255, 0.035) 3px 4px),
      radial-gradient(circle, #23263a 0 66%, #14172a 67% 69%, #1a1d2e 70% 100%);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45), inset 0 0 0 1px #2a2e4a;
    overflow: hidden;
  }
  /* Light catching the grooves. The grooves are concentric, so this sweep
     is what makes the record read as spinning. */
  .sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      transparent 0 8%,
      rgba(255, 255, 255, 0.09) 13%,
      transparent 20% 52%,
      rgba(255, 255, 255, 0.06) 60%,
      transparent 68%
    );
  }
  .disc-label {
    width: 68%;
    height: 68%;
    overflow: hidden;
    background: #1e2340;
    box-shadow: 0 0 0 3px var(--amber), 0 0 0 6px #14172a;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--dim);
    text-align: center;
  }
  .disc-label :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Slight zoom: Evan plus enough of the dish to see where he is. */
    object-position: 42% 50%;
    transform: scale(1.12);
    transform-origin: 40% 45%;
  }
  /* Rings start at the record's edge. They animate transform (scale), so
     centre them with margins instead of translate. */
  .ring {
    width: 100%;
    height: 100%;
    transform: none;
    margin: -50% 0 0 -50%;
  }

  @media (max-width: 640px) {
    .hero {
      gap: 48px;
      padding: 64px 0 88px;
    }
    p { font-size: 17px; }
  }
</style>
