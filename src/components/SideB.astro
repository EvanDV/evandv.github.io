---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { fullTitle, projectUrl, trackLabel, type Project } from '../lib/projects';

interface Props {
  projects: Project[];
  /** Cover images by project id, used when a project has no hero. */
  covers?: Record<string, ImageMetadata>;
}

const { projects, covers = {} } = Astro.props;
const coverOf = (p: Project) => p.data.hero ?? covers[p.id];
---

<section id="projects" class="section container" aria-labelledby="side-b">
  <div class="head">
    <h2 id="side-b">Side B <span class="sub">· for fun</span></h2>
  </div>
  <ul class="grid">
    {
      projects.map((p) => (
        <li>
          <a href={projectUrl(p)}>
            <div class="cover">
              {coverOf(p) ? (
                <Image src={coverOf(p)!} alt="" width={560} height={560} />
              ) : (
                <span class="mono">[PLACEHOLDER: IMAGE]</span>
              )}
            </div>
            <span class="num">{trackLabel(p)}</span>
            <h3>{fullTitle(p)}</h3>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .section {
    max-width: calc(var(--max) + 48px);
    padding: 64px 24px 112px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .head {
    border-bottom: 1px solid var(--line);
    padding-bottom: 20px;
  }
  h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(40px, 8vw, 56px);
    line-height: 1.1;
  }
  .sub {
    font-style: italic;
    color: var(--dim);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 24px;
  }
  .grid a {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: var(--text);
  }
  .cover {
    aspect-ratio: 1;
    background: rgba(23, 27, 49, 0.8);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .cover .mono {
    font-size: 12px;
    color: var(--faint);
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .num {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
  }
  h3 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 28px;
    transition: color 0.2s;
  }
  .grid a:hover h3 { color: var(--amber); }
  .grid a:hover .cover { border-color: var(--amber); }
</style>
